#!/usr/bin/env bash
# Runs every time an existing orb wakes. Fast, idempotent repair only —
# Amp waits at most 10 seconds. Dependency installation belongs in .agents/setup.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# Kernel state does not survive a fresh boot from a snapshot: re-allow memory
# overcommit or oxlint (via `vp check`) panics reserving its ~4 GiB arenas.
if [ "$(cat /proc/sys/vm/overcommit_memory)" != "1" ]; then
  sudo -n sysctl -q -w vm.overcommit_memory=1
fi

# Re-link the vp CLI in case /usr/local was reset but node_modules survived.
if [ -x "$repo_root/node_modules/.bin/vp" ]; then
  ln -sf "$repo_root/node_modules/.bin/vp" /usr/local/bin/vp
fi

# Quick sanity check; failures surface in the orb resume output.
node --version >/dev/null
pnpm --version >/dev/null
